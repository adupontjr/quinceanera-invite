rules_version = '2';

// Guests may submit an RSVP but cannot read, edit, or delete anyone's entry.
// Read RSVPs from the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvps/{rsvpId} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'email', 'guests', 'attending', 'message', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.guests is int
                    && request.resource.data.guests >= 1
                    && request.resource.data.guests <= 20;
      allow read, update, delete: if false;
    }
  }
}
